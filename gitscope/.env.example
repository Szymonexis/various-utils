# Copy this file to .env and edit REPOS_ROOT.
#
# REPOS_ROOT is the folder on your machine that holds your git repositories.
# Everything under it becomes browsable in the dashboard, nothing outside it is visible.
# Use forward slashes on every OS, Docker Desktop understands C:/... on Windows.
#
#   Windows : REPOS_ROOT=C:/Users/simon/code
#   macOS   : REPOS_ROOT=/Users/simon/code
#   Linux   : REPOS_ROOT=/home/simon/code
#   WSL     : run docker compose from inside WSL and use the Linux path
#
REPOS_ROOT=C:/Users/simon/code

# Port the dashboard listens on: http://localhost:8080
PORT=8080

# 0 = pick automatically (2..8 depending on CPU count)
BLAME_WORKERS=0

# Ownership skips files longer than this many lines
BLAME_MAX_LINES=20000
